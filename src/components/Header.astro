---
import { SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const links = [
	{ href: '/', text: 'Trang chủ', on: path === '/' },
	{ href: '/blog/', text: 'Bài viết', on: path.startsWith('/blog') },
	{ href: '/apps/', text: 'App SGK', on: path.startsWith('/apps') },
	{ href: '/about/', text: 'Giới thiệu', on: path.startsWith('/about') },
];
---

<a class="skip" href="#noi-dung">Bỏ qua, tới nội dung chính</a>
<header class="header">
	<div class="wrap">
		<a class="logo" href="/"><i></i>{SITE_TITLE}</a>
		<nav class="nav" aria-label="Điều hướng chính">
			{links.map((l) => <a href={l.href} aria-current={l.on ? 'page' : undefined}>{l.text}</a>)}
		</nav>
		<button class="theme-btn" id="themeBtn" type="button" aria-label="Đổi giao diện sáng hoặc tối">
			<svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
			<svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path></svg>
			<span id="themeName">Sáng</span>
			<small>tự động</small>
		</button>
	</div>
</header>
