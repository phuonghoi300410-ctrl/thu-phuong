---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, TOPICS, topicOf } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...rest] = posts;
const recent = rest.slice(0, 5);
const countOf = (slug: string) => posts.filter((p) => p.data.topic === slug).length;
---

<!doctype html>
<html lang="vi" data-theme="light">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="noi-dung">
			<section class="hero">
				<div class="wrap">
					<p class="label" id="greeting">Xin chào</p>
					<h1>Cùng con lớn lên <em>thời AI</em>.</h1>
					<p>
						Ghi chép của Thu Phương, một người mẹ có con học cấp 1 và cấp 2: cách ba mẹ đồng hành
						cùng con khi AI đã vào nhà, và cách dùng AI cho gọn việc mỗi ngày.
					</p>
					<div class="cta">
						<a class="btn btn-main" href="#h-noi-bat">Đọc bài mới nhất</a>
						<a class="btn btn-line" href="/about/">Về Thu Phương</a>
					</div>
				</div>
			</section>

			{
				featured && (
					<section class="section" aria-labelledby="h-noi-bat">
						<div class="wrap">
							<div class="section-head">
								<h2 id="h-noi-bat">Bài nổi bật</h2>
							</div>
							<article class="feature">
								<div class="feature-art" aria-hidden="true">
									<span class="c1" />
									<span class="c2" />
									<span class="c3" />
								</div>
								<div class="feature-body">
									<p class="label">Mới nhất</p>
									<h3>
										<a href={`/blog/${featured.id}/`}>{featured.data.title}</a>
									</h3>
									<p>{featured.data.description}</p>
									<p class="meta">
										<FormattedDate date={featured.data.pubDate} />
									</p>
								</div>
							</article>
						</div>
					</section>
				)
			}

			<section class="section" aria-labelledby="h-chu-de">
				<div class="wrap">
					<div class="section-head">
						<h2 id="h-chu-de">Chủ đề</h2>
					</div>
					<div class="topics">
						{
							TOPICS.map((t) => (
								<a class={`topic ${topicOf(t.slug)!.tile}`} href="/blog/">
									<b>{t.name}</b>
									<span>{countOf(t.slug) ? `${countOf(t.slug)} bài` : 'Sắp có bài'}</span>
								</a>
							))
						}
					</div>
				</div>
			</section>

			{
				recent.length > 0 && (
			<section class="section" id="bai-moi" aria-labelledby="h-bai-moi">
				<div class="wrap">
					<div class="section-head">
						<h2 id="h-bai-moi">Bài mới</h2>
						<a href="/blog/">Tất cả bài viết →</a>
					</div>
					<ol class="posts">
						{
							recent.map((post) => (
								<li class="post">
									<span class="meta">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<div>
										<h3>
											<a href={`/blog/${post.id}/`}>{post.data.title}</a>
										</h3>
										<p>{post.data.description}</p>
									</div>
									{topicOf(post.data.topic) && (
										<span class={`tag ${topicOf(post.data.topic)!.tile}`}>
											{topicOf(post.data.topic)!.name}
										</span>
									)}
								</li>
							))
						}
					</ol>
				</div>
			</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>
